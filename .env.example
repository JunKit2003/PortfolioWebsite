# Copy to .env and fill in. Never commit .env.

# Postgres (used by the db container)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# API (host must be "db" inside compose; use localhost:54329 for local dev outside Docker)
DATABASE_URL=postgres://portfolio:change-me@db:5432/portfolio
API_PORT=3000

# SMTP (for local dev, point at Mailpit: SMTP_HOST=mailpit or localhost, SMTP_PORT=1025)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=app-password
MAIL_FROM="Portfolio <you@example.com>"
MAIL_TO=you@example.com

# OpenObserve log shipping (optional; only used by the `observability` compose profile)
# Endpoint is the org's OTLP base URL, e.g. https://openobserve.example.com/api/default
# O2_AUTH is base64 of "user:password": printf '%s' 'user:pass' | base64
O2_OTLP_ENDPOINT=
O2_AUTH=
